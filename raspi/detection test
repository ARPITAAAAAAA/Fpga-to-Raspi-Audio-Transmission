import spidev
import numpy as np
import joblib
import time

# ================= SPI =================
spi = spidev.SpiDev()
spi.open(0, 0)
spi.max_speed_hz = 500000
spi.mode = 0

# ================= LOAD =================
model = joblib.load("model.pkl")
mean = np.load("mean.npy")
std = np.load("std.npy")

labels = ["HI", "BYE", "HOW ARE YOU"]

N = 64

print("Starting detection...\n")

while True:
    raw = spi.xfer([0x00] * N)
    fft = np.array(raw)

    print("-------------------")
    print("Raw:", fft.tolist())

    # ================= FILTER BAD DATA =================
    if len(set(fft)) < 5:
        print("Invalid SPI data\n")
        time.sleep(0.5)
        continue

    if np.max(fft) < 10:
        print("No signal\n")
        time.sleep(0.5)
        continue

    # ================= NORMALIZATION =================
    fft = fft.astype(float)
    fft = (fft - mean) / std

    fft = fft.reshape(1, -1)

    # ================= PREDICTION =================
    pred = model.predict(fft)[0]
    probs = model.predict_proba(fft)[0]
    confidence = max(probs)

    print("Confidence:", confidence)

    if confidence < 0.6:
        print("Uncertain")
        print("-------------------\n")
        continue

    print("Detected:", labels[pred])
    print("-------------------\n")

    time.sleep(0.5)
