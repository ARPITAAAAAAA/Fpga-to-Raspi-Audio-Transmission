import numpy as np
from sklearn.svm import SVC
import joblib

# ================= LOAD =================
hi = np.load("hi_samples.npy")
bye = np.load("bye_samples.npy")
how = np.load("how are you_samples.npy")

# ================= LABELS =================
X = np.vstack((hi, bye, how))
y = np.array(
    [0]*len(hi) +
    [1]*len(bye) +
    [2]*len(how)
)

print("HI:", len(hi), "BYE:", len(bye), "HOW:", len(how))
print("Total:", X.shape)

# ================= NORMALIZATION (IMPORTANT) =================
X = X.astype(float)

mean = np.mean(X, axis=0)
std = np.std(X, axis=0) + 1e-6

X = (X - mean) / std

# Save normalization
np.save("mean.npy", mean)
np.save("std.npy", std)

# ================= MODEL =================
model = SVC(kernel='rbf', class_weight='balanced', probability=True)
model.fit(X, y)

joblib.dump(model, "model.pkl")

print("Training complete!")
